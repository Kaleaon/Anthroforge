[Unit]
Description=AnthroForge bot backend (@anthroforge_bot — Mini App /start + web_app_data saver)
After=network.target

[Service]
Type=simple
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128 HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=http_proxy=http://hatch-egress-proxy:3128 https_proxy=http://hatch-egress-proxy:3128
Environment=NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem REQUESTS_CA_BUNDLE=/run/hatch/egress-tls/ca-bundle.pem
Environment=PATH=/opt/hatch/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/home/hatch/workspace/anthroforge-app/telegram-miniapp
ExecStart=/usr/bin/python3 /home/hatch/workspace/anthroforge-app/telegram-miniapp/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/home/hatch/workspace/anthroforge-app/telegram-miniapp/bot.log
StandardError=append:/home/hatch/workspace/anthroforge-app/telegram-miniapp/bot.log

[Install]
WantedBy=multi-user.target
