{
  "extensions": {
    "acceptance": {
      "gate": "Measure on the neutral-pose exported mesh at value 1.0 (HIMBO big-end 100) with the traps family pinned (ArmsTrapsMeat 100, ArmsTrapsPush 90+). All three must pass; a miss is build data, not a spec edit.",
      "m1_neck_head": "M1 neck width / head width (front span at jaw level / bizygomatic span) >= 1.05 (BARA_LESSONS section 5; bara target band 1.05-1.20). Corrective if low: raise this slider, then ArmsTrapsMeat / Weight (A3 wiring).",
      "m7_visible_neck": "M7 visible neck length / head height (chin to trap line, front view) <= 0.25 (strongman band 0.15-0.25).",
      "scm_groove": "The front sternocleidomastoid V-groove must still read in the front render at full value (BARA_LESSONS R8): a thick neck must stay a neck, not become a column of trap. If the groove is gone, the field is too wide - narrow it medially (front-centre exclusion in the mask) and re-test."
    },
    "build_spec": {
      "field_construction": "Blend of two decoded HIMBO fields on the source base: (1) the neck-region vertex subset of the 'HIMBO - BodyWeight 0 to 1' block (7,797 diff verts; 46% of its displacement is neck-region [S]) as the primary mass field, (2) the 'HIMBO - BodyArmsTrapsMeat' block (480 diff verts, 100% neck/trap region, max 0.641 units) as the trap-cone reinforcement. Restrict both to the region mask before blending; weight the trap component higher laterally (outer clavicle), the Weight component higher at the neck column.",
      "status": "RECORD ONLY (authored Nov 12, 2026, per BARA_LESSONS section 6 A2). No instance geometry exists yet; the geometry proof is a separate build. Until an instance lands, presets use the interim recipe: Weight high + ArmsTrapsMeat pinned (the recipe Sen's vector in presets-titan-batch1.md section 4.2 already satisfies).",
      "trap_clavicle_budget": "R6: the visible neck cone is trapezius wrapping to the OUTER two-thirds of the clavicle run; the inner third is true neck. The mask weights the band accordingly - trap mass over the outer 2/3 of the sternum-to-acromion line, neck column over the inner 1/3 - so the front silhouette reads head -> sloping trap cone -> shoulders, never head -> vertical neck sides -> shoulders.",
      "yoke_first_rule": "R4/R5 (BARA_LESSONS section 2): the traps+neck cluster is the primary size signal and is set FIRST among muscle sliders on any bara build, pinned near max at the strongman pole. Floor: neck front width at jaw level must never fall below the jaw (bi-angular) width - 'no lollipop'. The field must not be authored so that any bara preset value produces neck < jaw."
    },
    "preset_calls": {
      "note": "Values in this record's normalised units (1.0 = HIMBO big-end 100). orc_bara_strongman calls NeckMass 90 per BARA_LESSONS section 6 B (interim recipe already satisfied by Weight 85 + ArmsTrapsMeat 100, so no interim preset change). Other bara vectors set it when their build runs the A3 QA gates.",
      "orc_bara_strongman": 0.9
    }
  },
